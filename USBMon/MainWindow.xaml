<Window x:Class="USBMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Mon" MinWidth="760" MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="EventRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource EventGridRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="USB Mon" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ThemeBox" Width="110" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="System"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!-- Update banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10" Padding="14,8"
                CornerRadius="8" BorderThickness="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" MinHeight="28" Click="UpdateDismiss_Click" ToolTip="Hide"/>
                <Button x:Name="UpdateInstallButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Install update"
                        Margin="8,0,8,0" Click="UpdateInstall_Click"/>
                <Button DockPanel.Dock="Right" Content="What's new" Click="UpdateNotes_Click"/>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Filter bar (reserved area; no filters defined yet) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
            <TextBlock Text="Filters — none defined yet" Style="{StaticResource SecondaryText}" IsEnabled="False"/>
        </Border>

        <!-- Event grid -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="EventGrid" BorderThickness="0" HorizontalScrollBarVisibility="Auto"
                      RowStyle="{StaticResource EventRowStyle}"
                      MouseDoubleClick="EventGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Explicit MinWidth on every column: without it, WPF's DataGrid silently
                         compresses fixed-width columns down to an illegible ~20px floor rather
                         than showing a horizontal scrollbar when the window is narrower than the
                         columns' combined preferred width. -->
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="150" MinWidth="110"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="100" MinWidth="90"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" MinWidth="120"/>
                    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="130" MinWidth="100"/>
                    <DataGridTextColumn Header="VID" Binding="{Binding VendorId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProductId}" Width="60" MinWidth="50"/>
                    <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="85" MinWidth="75"/>
                    <DataGridTextColumn Header="Serial number" Binding="{Binding SerialNumber}" Width="140" MinWidth="100"/>
                    <DataGridTextColumn Header="Device class" Binding="{Binding DeviceClass}" Width="100" MinWidth="90"/>
                    <DataGridTextColumn Header="Driver/service" Binding="{Binding Service}" Width="115" MinWidth="105"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150" MinWidth="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" MinWidth="100"/>
                    <DataGridTextColumn Header="Device instance ID" Binding="{Binding InstanceId}" Width="*" MinWidth="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="LogPathText" DockPanel.Dock="Left" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
